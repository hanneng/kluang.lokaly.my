# ---------------------------------------------------------------------------
# Lokaly platform — environment
#
# Copy to `.env.local` and fill in. Everything here is optional for local
# development: with no .env at all, the site runs on bundled seed content.
# ---------------------------------------------------------------------------

# --- Multi-town -------------------------------------------------------------
# Town served when the request hostname does not match a configured town
# (i.e. localhost). Must match a slug in src/config/towns/index.ts.
NEXT_PUBLIC_DEFAULT_TOWN=kluang

# Forces the canonical origin for every generated URL. Leave unset in
# production so each town derives its own origin from its domain. Useful for
# preview deployments.
# NEXT_PUBLIC_SITE_ORIGIN=https://kluang.lokaly.my

# --- Data source ------------------------------------------------------------
# `seed` (default) reads src/data/seed — no database needed.
# `supabase` reads Postgres via the Supabase client.
DATA_SOURCE=seed

# Set to 1 to allow seed content in a production build. Seed listings are
# illustrative and unverified; only use this for a demo deployment.
# ALLOW_SEED_IN_PRODUCTION=1

# --- Supabase ---------------------------------------------------------------
# Required when DATA_SOURCE=supabase.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Auth.js ----------------------------------------------------------------
# Required for the admin dashboard. Generate with: openssl rand -base64 32
# AUTH_SECRET=
# AUTH_URL=https://kluang.lokaly.my
# Comma-separated list of email addresses allowed into /admin.
# ADMIN_EMAILS=you@example.com

# --- Images (Cloudflare R2) -------------------------------------------------
# Public CDN hostname in front of the R2 bucket. Added to next.config image
# remotePatterns, so a new town needs a bucket folder, not a config change.
# NEXT_PUBLIC_R2_PUBLIC_HOST=cdn.lokaly.my
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=lokaly-media

# --- Map --------------------------------------------------------------------
# Vector tile style URL (MapTiler, Protomaps, self-hosted). Without this the
# map falls back to raster OpenStreetMap tiles, which are fine for development
# but must not be used for production traffic.
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

# --- Analytics --------------------------------------------------------------
# GA4 measurement id. Omit to disable analytics entirely.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Indexing ---------------------------------------------------------------
# Set to 1 on preview/staging so robots.txt disallows everything.
# NEXT_PUBLIC_BLOCK_INDEXING=1
