# Normalise line endings so files that run on the Linux server are never
# checked out with CRLF (which breaks shell scripts: `bash: cannot execute`).
* text=auto eol=lf

# Belt-and-braces for the files that MUST be LF regardless of the above —
# these are executed/parsed on the server.
*.sh            text eol=lf
*.mjs           text eol=lf
*.sql           text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
deploy/**       text eol=lf

# Binary assets git should never touch.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.avif          binary
*.ico           binary
*.woff          binary
*.woff2         binary
