# Server-side production environment.
#
# This is the file that lives on the server at /opt/lokaly/app/.env.production.
# It is NOT the same as the repo-root .env.example (which documents local dev).
# It holds real secrets, so on the server it must be owned by `lokaly` and
# chmod 600, and it must never be committed. This template has the secrets
# blanked.
#
# Create it on the server without it ever touching the repo, e.g.:
#   ssh ... 'sudo tee /opt/lokaly/app/.env.production >/dev/null' < your-local-copy
#   ssh ... 'sudo chown lokaly:lokaly /opt/lokaly/app/.env.production'
#   ssh ... 'sudo chmod 600 /opt/lokaly/app/.env.production'
#
# NOTE: write it as UTF-8 WITHOUT a BOM. A leading BOM makes the shell read the
# first line as `<BOM>NODE_ENV=production` and silently drop NODE_ENV.

NODE_ENV=production
PORT=3000
NEXT_PUBLIC_DEFAULT_TOWN=kluang

# --- Data source ---
# `postgres` = native pg adapter against a plain managed Postgres (Lightsail).
DATA_SOURCE=postgres

# --- Lightsail managed Postgres ---
# The instance must be in "public mode" OR on the same Lightsail private
# network with the app instance allowlisted, and the DB name is usually
# `dbmaster` (Lightsail's default), not `postgres`.
DB_HOST=
DB_PORT=5432
DB_USER=dbmasteruser
DB_PASSWORD=
DB_NAME=dbmaster
DB_SSLMODE=require

# --- Images (S3 media storage) ---
# Public base URL serving the bucket. Images are stored as bare keys in the DB
# and resolved against this at read time, so a later move to CloudFront is a
# one-line change here. The bucket must be public-read for direct S3 URLs.
# (ap-southeast-5 = AWS Malaysia, close to visitors.)
NEXT_PUBLIC_MEDIA_BASE_URL=https://kluang-lokaly-my.s3.ap-southeast-5.amazonaws.com

# Upload credentials are NOT needed on the server — uploads run from a
# workstation via scripts/upload-media.mjs. Only set S3_* here if something
# on the server itself ever needs to write to the bucket.

# --- Analytics (optional) ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
