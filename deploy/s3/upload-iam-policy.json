{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadMediaObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::kluang-lokaly-my/*"
    },
    {
      "Sid": "ListForTooling",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::kluang-lokaly-my"
    }
  ]
}
