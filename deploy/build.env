# Build-time environment for production deploys.
#
# ONLY non-secret, NEXT_PUBLIC_* values belong here. NEXT_PUBLIC_ vars are
# inlined into the bundle at `next build` time (not read at runtime), so they
# must be present when building — and since the build happens on a workstation,
# they can't come from the server's .env.production. build-and-deploy.sh sources
# this file before building. It is committed because every value here is already
# public (they end up in the shipped HTML/JS). NEVER put secrets in this file.

# Public base URL that serves the S3 media bucket (ap-southeast-5 = AWS Malaysia).
# Images are stored as bare keys in the DB and resolved against this. To move to
# CloudFront later, change this one line and redeploy — no data migration.
NEXT_PUBLIC_MEDIA_BASE_URL=https://kluang-lokaly-my.s3.ap-southeast-5.amazonaws.com
